#!/usr/bin/env bash
# tunnelsnake — openvpn3 bridge for the Tunnelsnake Omarchy bar widget.
#
# Every subcommand prints one JSON object on stdout so the QML side can
# JSON.parse() it directly. Failures are reported inside the payload (the
# "error" or "message" field) rather than on stderr, so a failed call still
# renders in the panel instead of vanishing.

set -uo pipefail

OVPN3=${TUNNELSNAKE_OPENVPN3:-openvpn3}
RESOLVECTL=${TUNNELSNAKE_RESOLVECTL:-resolvectl}
IP_BIN=${TUNNELSNAKE_IP:-ip}
WIDGET_ID=${TUNNELSNAKE_WIDGET_ID:-linting.tunnelsnake}

# What counts as a profile on disk. openvpn3 will take any file it can parse,
# but these are the two suffixes people actually ship.
PROFILE_SUFFIXES=("ovpn" "conf")

# A directory listing is drawn one row at a time; a home folder full of build
# output would be a wall of rows nobody scrolls through.
BROWSE_LIMIT=${TUNNELSNAKE_BROWSE_LIMIT:-400}

usage() {
  cat <<'USAGE'
tunnelsnake — openvpn3 bridge for the Tunnelsnake Omarchy bar widget

Usage: tunnelsnake <command> [args]

  status                      Sessions, link details, and transfer counters
  profiles [DIR ...]          Profiles in DIRs plus openvpn3-imported configs
  browse [DIR] [--hidden]     One directory: sub-folders and profile files
  connect PROFILE [opts]      Start a session, wait for the tun device, wire DNS
  reconnect PROFILE [opts]    Drop every session first, then connect
  disconnect [SESSION_PATH]   Disconnect one session, or all of them
  import FILE [--name NAME]   Import a profile into openvpn3, persistently
  set KEY VALUE               Save a widget setting into shell.json
  dns DEVICE [opts]           Re-apply DNS to a device that is already up

Options for connect/reconnect/dns:
  --dns-server ADDR     DNS server to pin on the tunnel device
  --dns-domain DOMAIN   Routing domain, repeatable (~example.com routes only that domain)
  --timeout SECS        How long to wait for the tun device (default 30)

PROFILE is either a path to a .ovpn/.conf file or the D-Bus path of a
configuration already imported into openvpn3.

The DNS calls go through resolvectl as your own user: systemd-resolved asks
polkit, Omarchy's polkit agent prompts once, and the answer is cached. Only if
that path fails do we retry under pkexec.
USAGE
}

# ------------------------------------------------------------------ JSON bits

json_str() {
  local s=${1-}
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\r'/}
  s=${s//$'\t'/ }
  s=${s//$'\n'/ }
  # Anything else below 0x20 is not printable and not escapable by the rules
  # above, so drop it rather than emit JSON no parser will take.
  if [[ $s == *[$'\001'-$'\037']* ]]; then
    s=$(tr -d '\001-\037' <<<"$s")
  fi
  printf '"%s"' "$s"
}

json_or_null() {
  [[ -n ${1-} ]] && json_str "$1" || printf 'null'
}

json_words() {
  # Space-separated words -> JSON array of strings.
  local out="" word
  for word in ${1-}; do
    [[ -n $out ]] && out+=","
    out+=$(json_str "$word")
  done
  printf '[%s]' "$out"
}

trim() {
  local s=${1-}
  s=${s#"${s%%[![:space:]]*}"}
  s=${s%"${s##*[![:space:]]}"}
  printf '%s' "$s"
}

expand_home() {
  local p=${1-}
  [[ $p == "~" ]] && p=$HOME
  [[ $p == "~/"* ]] && p="$HOME/${p#\~/}"
  printf '%s' "$p"
}

have_openvpn3() { command -v "$OVPN3" >/dev/null 2>&1; }

strip_suffix() {
  local name=${1-} suffix
  for suffix in "${PROFILE_SUFFIXES[@]}"; do
    [[ ${name,,} == *.$suffix ]] && { printf '%s' "${name%.*}"; return 0; }
  done
  printf '%s' "$name"
}

# ------------------------------------------------------------------- sessions

SESSIONS_JSON="[]"
SESSION_COUNT=0
SESSION_PATHS=()
AUTH_URLS=()
ACTIVE_PATH=""
ACTIVE_DEVICE=""
ACTIVE_STATE="disconnected"
ACTIVE_AUTH_URL=""

# `session-start --background` never prints the sign-in URL — it only says the
# session is running. The URL lives in `session-auth`, for as long as the
# session sits there waiting, which also means it survives a shell restart.
load_auth_urls() {
  local raw line trimmed path="" url=""
  AUTH_URLS=()
  raw=$("$OVPN3" session-auth 2>/dev/null)
  while IFS= read -r line; do
    trimmed=$(trim "$line")
    case $trimmed in
      Path:*)
        path=$(trim "${trimmed#Path:}")
        ;;
      "Auth URL:"*)
        url=$(trim "${trimmed#Auth URL:}")
        if [[ -n $path && -n $url ]]; then
          AUTH_URLS+=("$path"$'\t'"$url")
        fi
        path=""
        url=""
        ;;
    esac
  done <<<"$raw"
}

auth_url_for() {
  local wanted=${1-} entry
  for entry in ${AUTH_URLS[@]+"${AUTH_URLS[@]}"}; do
    [[ ${entry%%$'\t'*} == "$wanted" ]] && { printf '%s' "${entry#*$'\t'}"; return 0; }
  done
  printf ''
}

# openvpn3 reports "Connection, Client connected" and friends; collapse the
# variants into the four states the widget actually draws.
state_from_status() {
  local s=${1-}
  s=${s,,}
  case $s in
    *"client connected"*|*"connection, connected"*)      printf 'connected' ;;
    # Checked before the generic auth match: "authentication failed" is a dead
    # session, not one waiting for you.
    *fail*|*error*|*denied*|*expired*)                   printf 'failed' ;;
    *"web authentication"*|*"authentication required"*)  printf 'needs-auth' ;;
    *paused*)                                            printf 'paused' ;;
    *connecting*|*resolv*|*wait*|*auth*|*reconnect*|*"client restart"*) printf 'connecting' ;;
    *disconnect*)                                        printf 'disconnected' ;;
    *)                                                   printf 'unknown' ;;
  esac
}

collect_sessions() {
  local raw line trimmed
  local path="" created="" owner="" device="" config="" name="" status=""
  local items="" count=0

  SESSIONS_JSON="[]"
  SESSION_COUNT=0
  SESSION_PATHS=()
  ACTIVE_PATH=""
  ACTIVE_DEVICE=""
  ACTIVE_STATE="disconnected"
  ACTIVE_AUTH_URL=""

  # Bash is dynamically scoped, so this helper reads and resets the record
  # variables declared above.
  _flush_session() {
    [[ -z $path ]] && return 0
    local state auth_url
    state=$(state_from_status "$status")
    auth_url=$(auth_url_for "$path")
    [[ -n $items ]] && items+=","
    items+="{\"path\":$(json_str "$path")"
    items+=",\"created\":$(json_str "$created")"
    items+=",\"owner\":$(json_str "$owner")"
    items+=",\"device\":$(json_str "$device")"
    items+=",\"config\":$(json_str "$config")"
    items+=",\"name\":$(json_str "$name")"
    items+=",\"status\":$(json_str "$status")"
    items+=",\"state\":$(json_str "$state")"
    items+=",\"authUrl\":$(json_or_null "$auth_url")}"
    SESSION_PATHS+=("$path")
    count=$((count + 1))
    # The connected session wins the "active" slot; otherwise the first one
    # keeps it, so a stalled connection still shows its device and status.
    if [[ -z $ACTIVE_PATH || ( $state == connected && $ACTIVE_STATE != connected ) ]]; then
      ACTIVE_PATH=$path
      ACTIVE_DEVICE=$device
      ACTIVE_STATE=$state
      ACTIVE_AUTH_URL=$auth_url
    fi
    path=""; created=""; owner=""; device=""; config=""; name=""; status=""
  }

  raw=$("$OVPN3" sessions-list 2>&1)
  # Only worth a second D-Bus round trip when something is actually parked.
  if [[ ${raw,,} == *authentication* ]]; then load_auth_urls; else AUTH_URLS=(); fi

  while IFS= read -r line; do
    trimmed=$(trim "$line")
    case $trimmed in
      Path:*)
        _flush_session
        path=$(trim "${trimmed#Path:}")
        ;;
      Created:*)
        created=$(trim "${trimmed#Created:}")
        created=$(trim "${created%%PID:*}")
        ;;
      Owner:*)
        owner=$(trim "${trimmed#Owner:}")
        owner=$(trim "${owner%%Device:*}")
        ;;
      "Config name:"*)
        config=$(trim "${trimmed#Config name:}")
        [[ $config =~ ^(.*[^[:space:]])[[:space:]]*\([^\)]*\)$ ]] && config=${BASH_REMATCH[1]}
        ;;
      "Session name:"*)
        name=$(trim "${trimmed#Session name:}")
        ;;
      Status:*)
        status=$(trim "${trimmed#Status:}")
        ;;
    esac
    # Device rides along at the end of the Owner line.
    if [[ $trimmed == *Device:* ]]; then
      device=$(trim "${trimmed#*Device:}")
      device=${device%% *}
      [[ $device == "(not" || $device == "N/A" ]] && device=""
    fi
  done <<<"$raw"
  _flush_session

  SESSIONS_JSON="[$items]"
  SESSION_COUNT=$count
}

link_json() {
  local dev=${1-}
  if [[ -z $dev ]]; then
    printf '{"device":null,"ipv4":null,"dns":[],"domains":[]}'
    return 0
  fi
  local ipv4 dns domains
  ipv4=$("$IP_BIN" -4 -o addr show "$dev" 2>/dev/null | awk '{print $4; exit}')
  # resolvectl prints "Link 12 (tun0): 1.2.3.4"; keep only what follows.
  dns=$("$RESOLVECTL" dns "$dev" 2>/dev/null | sed 's/^.*): *//' | tr '\n' ' ')
  domains=$("$RESOLVECTL" domain "$dev" 2>/dev/null | sed 's/^.*): *//' | tr '\n' ' ')
  printf '{"device":%s,"ipv4":%s,"dns":%s,"domains":%s}' \
    "$(json_str "$dev")" \
    "$(json_or_null "$ipv4")" \
    "$(json_words "$dns")" \
    "$(json_words "$domains")"
}

stats_json() {
  local path=${1-} raw
  [[ -z $path ]] && { printf 'null'; return 0; }
  raw=$("$OVPN3" session-stats --path "$path" --json 2>/dev/null | tr -d '\n')
  [[ ${raw:0:1} == "{" ]] || { printf 'null'; return 0; }
  printf '%s' "$raw"
}

# ------------------------------------------------------------------- commands

cmd_status() {
  if ! have_openvpn3; then
    printf '{"installed":false,"state":"missing","activePath":"","authUrl":null,"sessionCount":0,"sessions":[],"link":null,"stats":null,"error":"openvpn3 is not installed"}\n'
    return 0
  fi
  collect_sessions
  printf '{"installed":true,"state":%s,"activePath":%s,"authUrl":%s,"sessionCount":%d,"sessions":%s,"link":%s,"stats":%s,"error":null}\n' \
    "$(json_str "$ACTIVE_STATE")" "$(json_str "$ACTIVE_PATH")" \
    "$(json_or_null "$ACTIVE_AUTH_URL")" "$SESSION_COUNT" \
    "$SESSIONS_JSON" "$(link_json "$ACTIVE_DEVICE")" "$(stats_json "$ACTIVE_PATH")"
}

# `configs-list --json` is the only output shape that survives a profile name
# with spaces in it; the column-aligned table runs the name into the owner
# column and there is no way to tell where one ends. awk walks the object
# because pulling in jq for three fields would make it a runtime dependency of
# the widget rather than of its tests.
imported_json() {
  awk '
    function emit() {
      if (path != "" && name != "") printf "%s%s%s%s%s\n", path, sep, name, sep, valid
      path = ""; name = ""; valid = "true"
    }
    BEGIN { sep = sprintf("%c", 31); path = ""; name = ""; valid = "true" }
    /"\/net\/openvpn\/v3\/configuration\// {
      if (match($0, /\/net\/openvpn\/v3\/configuration\/[^"]+/)) {
        emit()
        path = substr($0, RSTART, RLENGTH)
        next
      }
    }
    /"name"[ \t]*:/ {
      if (match($0, /:[ \t]*"/)) {
        rest = substr($0, RSTART + RLENGTH)
        sub(/",?[ \t]*$/, "", rest)
        gsub(/\\"/, "\"", rest)
        gsub(/\\\\/, "\\", rest)
        name = rest
      }
      next
    }
    /"valid"[ \t]*:/ { valid = ($0 ~ /true/) ? "true" : "false"; next }
    END { emit() }
  '
}

# Older openvpn3 builds have no --json. The verbose table still carries the
# D-Bus path that session-start needs, one record per config:
#   /net/openvpn/v3/configuration/<id>
#   <imported>            <last used>        <use count>
#   [!! ]<name>           <owner>
imported_verbose() {
  awk '
    function emit() {
      if (path != "" && name != "") printf "%s%s%s%s%s\n", path, sep, name, sep, valid
      path = ""; name = ""; valid = "true"; row = 0
    }
    BEGIN { sep = sprintf("%c", 31); path = ""; name = ""; valid = "true"; row = 0 }
    /^\/net\/openvpn\/v3\/configuration\// { emit(); path = $0; row = 1; next }
    path == "" { next }
    /^-+$/ { emit(); next }
    { row++ }
    row == 3 {
      line = $0
      if (sub(/^!![ \t]*/, "", line)) valid = "false"
      # The owner is the last column; a name with spaces keeps everything
      # before it.
      sub(/[ \t]+[^ \t]+[ \t]*$/, "", line)
      sub(/[ \t]+$/, "", line)
      name = line
    }
    END { emit() }
  '
}

imported_profiles() {
  local items="" raw path name valid
  have_openvpn3 || { printf '%s' "$items"; return 0; }

  raw=$("$OVPN3" configs-list --json 2>/dev/null)
  if [[ ${raw:0:1} == "{" ]]; then
    raw=$(imported_json <<<"$raw")
  else
    raw=$("$OVPN3" configs-list -v 2>/dev/null | imported_verbose)
  fi

  while IFS=$'\x1f' read -r path name valid; do
    [[ -n $path && -n $name ]] || continue
    [[ -n $items ]] && items+=","
    items+="{\"kind\":\"imported\",\"id\":$(json_str "$path")"
    items+=",\"name\":$(json_str "$(strip_suffix "${name##*/}")")"
    items+=",\"path\":$(json_str "$path")"
    items+=",\"source\":$(json_str "$name")"
    items+=",\"valid\":${valid:-true}}"
  done <<<"$raw"
  printf '%s' "$items"
}

cmd_profiles() {
  local items dir file name
  local -A seen=()
  items=$(imported_profiles)
  for dir in "$@"; do
    dir=$(expand_home "$dir")
    [[ -d $dir ]] || continue
    while IFS= read -r file; do
      [[ -n $file ]] || continue
      # The same file reached through two configured folders (a folder and one
      # of its parents, say) is still one profile.
      [[ -n ${seen[$file]:-} ]] && continue
      seen[$file]=1
      name=${file##*/}
      [[ -n $items ]] && items+=","
      items+="{\"kind\":\"file\",\"id\":$(json_str "$file")"
      items+=",\"name\":$(json_str "$(strip_suffix "$name")")"
      items+=",\"path\":$(json_str "$file")"
      items+=",\"source\":$(json_str "$file")"
      items+=",\"valid\":true}"
    done < <(find -L "$dir" -maxdepth 2 -type f \
      \( -iname '*.ovpn' -o -iname '*.conf' \) 2>/dev/null | sort)
  done
  printf '{"profiles":[%s],"error":null}\n' "$items"
}

# One directory at a time, for the panel's file picker: sub-folders to walk
# into and the profile files you can actually pick. Everything else is noise
# in a list you are scrolling with the keyboard.
cmd_browse() {
  local dir="" hidden=0 arg
  while (($#)); do
    case ${1-} in
      --hidden) hidden=1 ;;
      --*)      ;;
      *)        [[ -z $dir ]] && dir=$1 ;;
    esac
    shift
  done

  dir=$(expand_home "$dir")
  [[ -n $dir ]] || dir=$HOME
  # A stale starting point (a folder that has since been renamed) should open
  # somewhere useful rather than fail.
  [[ -d $dir ]] || dir=$HOME
  dir=$(cd "$dir" 2>/dev/null && pwd -P) || dir=$HOME

  local parent=""
  [[ $dir != "/" ]] && parent=$(dirname "$dir")

  if [[ ! -r $dir || ! -x $dir ]]; then
    printf '{"dir":%s,"parent":%s,"home":%s,"entries":[],"truncated":false,"error":%s}\n' \
      "$(json_str "$dir")" "$(json_or_null "$parent")" "$(json_str "$HOME")" \
      "$(json_str "Cannot read $dir")"
    return 0
  fi

  local items="" count=0 truncated=false entry name
  # Directories first, then files: the same order the rows are drawn in, so
  # the panel never has to sort.
  local -a rows=()
  while IFS= read -r -d '' entry; do rows+=("d$entry"); done < <(
    find -L "$dir" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null | sort -zf)
  while IFS= read -r -d '' entry; do rows+=("f$entry"); done < <(
    find -L "$dir" -mindepth 1 -maxdepth 1 -type f \
      \( -iname '*.ovpn' -o -iname '*.conf' \) -print0 2>/dev/null | sort -zf)

  for entry in ${rows[@]+"${rows[@]}"}; do
    local kind=${entry:0:1} path=${entry:1}
    name=${path##*/}
    ((hidden == 0)) && [[ $name == .* ]] && continue
    if ((count >= BROWSE_LIMIT)); then truncated=true; break; fi
    [[ -n $items ]] && items+=","
    items+="{\"kind\":$([[ $kind == d ]] && printf '"dir"' || printf '"file"')"
    items+=",\"name\":$(json_str "$name")"
    items+=",\"path\":$(json_str "$path")}"
    count=$((count + 1))
  done

  printf '{"dir":%s,"parent":%s,"home":%s,"entries":[%s],"truncated":%s,"error":null}\n' \
    "$(json_str "$dir")" "$(json_or_null "$parent")" "$(json_str "$HOME")" \
    "$items" "$truncated"
}

apply_dns() {
  local dev=$1 server=$2
  shift 2
  local -a domains=("$@")
  local err="" resolvectl_bin
  resolvectl_bin=$(command -v "$RESOLVECTL" 2>/dev/null || printf '%s' "$RESOLVECTL")

  if [[ -n $server ]]; then
    if ! err=$("$RESOLVECTL" dns "$dev" "$server" 2>&1); then
      if ! err=$(pkexec "$resolvectl_bin" dns "$dev" "$server" 2>&1); then
        printf 'DNS server not applied: %s' "$(trim "$err")"
        return 1
      fi
    fi
  fi
  if ((${#domains[@]} > 0)); then
    if ! err=$("$RESOLVECTL" domain "$dev" "${domains[@]}" 2>&1); then
      if ! err=$(pkexec "$resolvectl_bin" domain "$dev" "${domains[@]}" 2>&1); then
        printf 'Search domains not applied: %s' "$(trim "$err")"
        return 1
      fi
    fi
  fi
  return 0
}

result_json() {
  local ok=$1 device=$2 message=$3 auth_url=${4-}
  printf '{"ok":%s,"device":%s,"message":%s,"authUrl":%s}\n' \
    "$ok" \
    "$(json_or_null "$device")" \
    "$(json_str "$(trim "$message")")" \
    "$(json_or_null "$auth_url")"
}

# Profiles behind an SSO portal make openvpn3 print a one-time sign-in URL and
# then wait. It is only ever in the session-start output, so pull it out there.
extract_auth_url() {
  grep -oE 'https?://[^[:space:]]+' <<<"${1-}" | head -1
}

cmd_connect() {
  local profile=${1-} timeout=30 dns_server=""
  local -a domains=()
  shift || true
  while (($#)); do
    case $1 in
      --dns-server) dns_server=${2-}; shift 2 ;;
      --dns-domain) [[ -n ${2-} ]] && domains+=("$2"); shift 2 ;;
      --timeout)    timeout=${2-30}; shift 2 ;;
      *)            shift ;;
    esac
  done

  have_openvpn3 || { result_json false "" "openvpn3 is not installed"; return 1; }
  [[ -n $profile ]] || { result_json false "" "No VPN profile chosen — pick one in the panel"; return 1; }

  local out rc
  if [[ $profile == /net/openvpn/v3/configuration/* ]]; then
    out=$("$OVPN3" session-start --config-path "$profile" --background --timeout "$timeout" 2>&1)
    rc=$?
  else
    profile=$(expand_home "$profile")
    [[ -f $profile ]] || { result_json false "" "Profile not found: $profile"; return 1; }
    [[ -r $profile ]] || { result_json false "" "Profile is not readable: $profile"; return 1; }
    out=$("$OVPN3" session-start --config "$profile" --background --timeout "$timeout" 2>&1)
    rc=$?
  fi
  if ((rc != 0)); then
    result_json false "" "${out:-openvpn3 session-start failed}" "$(extract_auth_url "$out")"
    return 1
  fi

  local auth_url
  auth_url=$(extract_auth_url "$out")

  # session-start returns as soon as the session object exists; the tun device
  # shows up a moment later, and the DNS wiring needs it by name.
  local dev="" i
  for ((i = 0; i < timeout; i++)); do
    collect_sessions
    if [[ $ACTIVE_STATE == needs-auth ]]; then
      result_json true "" "Sign-in required to finish connecting" "${ACTIVE_AUTH_URL:-$auth_url}"
      return 0
    fi
    dev=$ACTIVE_DEVICE
    if [[ -n $dev ]] && "$IP_BIN" link show "$dev" >/dev/null 2>&1; then break; fi
    dev=""
    sleep 1
  done

  if [[ -z $dev ]]; then
    result_json true "" "Session started, but no tun device appeared in ${timeout}s" "$auth_url"
    return 0
  fi

  local dns_msg=""
  if [[ -n $dns_server || ${#domains[@]} -gt 0 ]]; then
    if ! dns_msg=$(apply_dns "$dev" "$dns_server" ${domains[@]+"${domains[@]}"}); then
      result_json true "$dev" "$dns_msg"
      return 0
    fi
  fi
  result_json true "$dev" ""
}

# A session stuck waiting for sign-in cannot hand out a second URL, so the only
# way back is to drop it and start over.
cmd_reconnect() {
  have_openvpn3 || { result_json false "" "openvpn3 is not installed"; return 1; }
  collect_sessions
  local path
  for path in ${SESSION_PATHS[@]+"${SESSION_PATHS[@]}"}; do
    "$OVPN3" session-manage --path "$path" --disconnect >/dev/null 2>&1
  done
  cmd_connect "$@"
}

cmd_disconnect() {
  local target=${1-}
  have_openvpn3 || { result_json false "" "openvpn3 is not installed"; return 1; }

  local out="" failures=0 count=0 path
  if [[ -n $target && $target != --all ]]; then
    out=$("$OVPN3" session-manage --path "$target" --disconnect 2>&1) || failures=1
    count=1
  else
    collect_sessions
    if ((SESSION_COUNT == 0)); then
      result_json true "" "No active sessions"
      return 0
    fi
    for path in "${SESSION_PATHS[@]}"; do
      if ! out=$("$OVPN3" session-manage --path "$path" --disconnect 2>&1); then
        failures=$((failures + 1))
      fi
      count=$((count + 1))
    done
  fi

  if ((failures > 0)); then
    result_json false "" "${out:-Could not disconnect session}"
    return 1
  fi
  result_json true "" ""
}

# An imported profile outlives the file it came from and can be started by
# anyone the ACL allows, which is what you want for a profile you keep.
cmd_import() {
  local file=${1-} name=""
  shift || true
  while (($#)); do
    case $1 in
      --name) name=${2-}; shift 2 ;;
      *)      shift ;;
    esac
  done

  have_openvpn3 || { result_json false "" "openvpn3 is not installed"; return 1; }
  file=$(expand_home "$file")
  [[ -n $file && -f $file ]] || { result_json false "" "Profile not found: ${file:-<none>}"; return 1; }
  [[ -n $name ]] || name=$(strip_suffix "${file##*/}")

  local out rc
  out=$("$OVPN3" config-import --config "$file" --name "$name" --persistent 2>&1)
  rc=$?
  if ((rc != 0)); then
    result_json false "" "${out:-openvpn3 config-import failed}"
    return 1
  fi
  # The warning openvpn3 prints for a profile missing --ca is worth passing on:
  # the import worked, the connect will not. Otherwise say the import landed —
  # an import that reports nothing looks like an import that did nothing.
  local message="$name imported into openvpn3"
  [[ ${out,,} == *warning* ]] && message=$(trim "${out#*WARNING:}")
  result_json true "" "$message"
}

# The widget's own settings live in shell.json, which the running shell owns.
# Going through its IPC keeps the file's shape (and the in-place reload of
# every bar surface) the shell's business rather than ours.
cmd_set() {
  local key=${1-} value=${2-} shell_bin out
  [[ -n $key ]] || { result_json false "" "No setting name given"; return 1; }

  shell_bin=$(command -v omarchy-shell 2>/dev/null)
  [[ -n $shell_bin ]] || shell_bin="${OMARCHY_PATH:-/usr/share/omarchy}/bin/omarchy-shell"
  [[ -x $shell_bin ]] || { result_json false "" "omarchy-shell not found — set $key in ~/.config/omarchy/shell.json"; return 1; }

  out=$(OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}" \
    "$shell_bin" shell setBarWidget "$WIDGET_ID" "$key" "$(json_str "$value")" '{}' 2>&1)
  out=$(trim "$out")
  if [[ $out != "ok" ]]; then
    # The shell keeps a widget's settings on its bar entry, so a widget that is
    # not on the bar has nowhere to put them. Say that, rather than repeat the
    # shell's own wording at someone who never asked about widgets.
    [[ $out == "could not find widget"* ]] &&
      out="Tunnelsnake is not on the bar, so there is nowhere to save $key. Add it with: omarchy bar put $WIDGET_ID"
    result_json false "" "${out:-Could not save $key}"
    return 1
  fi
  result_json true "" ""
}

cmd_dns() {
  local dev=${1-} dns_server=""
  local -a domains=()
  shift || true
  while (($#)); do
    case $1 in
      --dns-server) dns_server=${2-}; shift 2 ;;
      --dns-domain) [[ -n ${2-} ]] && domains+=("$2"); shift 2 ;;
      *)            shift ;;
    esac
  done
  [[ -n $dev ]] || { result_json false "" "No device given"; return 1; }
  local msg=""
  if ! msg=$(apply_dns "$dev" "$dns_server" ${domains[@]+"${domains[@]}"}); then
    result_json false "$dev" "$msg"
    return 1
  fi
  result_json true "$dev" ""
}

main() {
  local cmd=${1-status}
  shift || true
  case $cmd in
    status)     cmd_status "$@" ;;
    profiles)   cmd_profiles "$@" ;;
    browse)     cmd_browse "$@" ;;
    connect)    cmd_connect "$@" ;;
    disconnect) cmd_disconnect "$@" ;;
    reconnect)  cmd_reconnect "$@" ;;
    import)     cmd_import "$@" ;;
    set)        cmd_set "$@" ;;
    dns)        cmd_dns "$@" ;;
    -h|--help|help) usage ;;
    *)          printf '{"error":%s}\n' "$(json_str "Unknown command: $cmd")"; return 2 ;;
  esac
}

main "$@"
