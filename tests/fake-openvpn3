#!/usr/bin/env bash
# Stand-in for openvpn3, driven by TUNNELSNAKE_FAKE_STATE. The layouts below are
# copied from real `openvpn3` v27.1 output, including the two shapes the Config
# name line takes, the way Device is left blank while a session is still being
# set up, and all three shapes configs-list answers in (--json, -v, and the
# plain table that carries no D-Bus path at all).
sep="-----------------------------------------------------------------------------"

case "$1" in
  sessions-list)
    case "${TUNNELSNAKE_FAKE_STATE:-none}" in
      none)
        echo "No sessions available"
        ;;
      up)
        cat <<OUT
$sep
        Path: /net/openvpn/v3/sessions/2f1c9e2ds4b1as9e12
     Created: 2026-08-20 09:14:02                       PID: 44121
       Owner: lint                                   Device: tun0
 Config name: /home/lint/vpn/work.ovpn  (Config not available)
Session name: vpn.example.com
      Status: Connection, Client connected
$sep
        Path: /net/openvpn/v3/sessions/77aa11bb22cc33dd44
     Created: 2026-08-20 09:20:41                       PID: 44987
       Owner: lint                                   Device: tun1
 Config name: backup.ovpn                (Config path: /net/openvpn/v3/configuration/bb22)
Session name: backup.example.com
      Status: Connection, Connecting
$sep
OUT
        ;;
      auth)
        cat <<OUT
$sep
        Path: /net/openvpn/v3/sessions/1f75b30bsb651s42c0
     Created: 2026-08-20 11:49:34                       PID: 116641
       Owner: lint                                   Device: 
 Config name: /home/lint/vpn/work.ovpn  (Config not available)
      Status: Web authentication required to connect
$sep
OUT
        ;;
      failed)
        cat <<OUT
$sep
        Path: /net/openvpn/v3/sessions/1f75b30bsb651s42c0
     Created: 2026-08-20 11:49:34                       PID: 116641
       Owner: lint                                   Device: 
 Config name: /home/lint/vpn/work.ovpn  (Config not available)
      Status: Connection, Client authentication failed: Authentication failed
$sep
OUT
        ;;
    esac
    ;;
  session-auth)
    if [[ ${TUNNELSNAKE_FAKE_STATE:-none} == auth ]]; then
      cat <<OUT
$sep
        Path: /net/openvpn/v3/sessions/1f75b30bsb651s42c0
Auth Request: 116641
     Created: 2026-08-20 11:49:34
 Config name: /home/lint/vpn/work.ovpn
 Auth status: On-going web authentication
    Auth URL: https://sso.example.com/saml/redirect/?RelayState=vpnauth~~abc123
$sep
OUT
    else
      echo "No sessions requires authentication interaction"
    fi
    ;;
  session-stats) echo '{"BYTES_IN":1048576,"BYTES_OUT":524288,"PACKETS_IN":900,"PACKETS_OUT":700}' ;;
  configs-list)
    # TUNNELSNAKE_FAKE_CONFIGS=legacy drops --json, the way an openvpn3 older
    # than v21 does, so the verbose-table fallback gets exercised too.
    if [[ ${2:-} == "--json" ]]; then
      if [[ ${TUNNELSNAKE_FAKE_CONFIGS:-json} == legacy ]]; then
        echo "openvpn3: unknown option --json" >&2
        exit 1
      fi
      cat <<'OUT'
{
	"/net/openvpn/v3/configuration/aa11" : 
	{
		"acl" : 
		{
			"locked_down" : false,
			"owner" : "lint",
			"public_access" : false
		},
		"dco" : false,
		"imported" : "2026-08-20 09:10:00",
		"lastused" : "2026-08-20 09:14:02",
		"name" : "work.ovpn",
		"use_count" : 3,
		"valid" : true
	},
	"/net/openvpn/v3/configuration/bb22" : 
	{
		"acl" : 
		{
			"locked_down" : false,
			"owner" : "lint",
			"public_access" : false
		},
		"dco" : false,
		"imported" : "2026-08-21 10:00:00",
		"invalid_reason" : " Configuration profile is missing required options: --ca",
		"lastused" : "",
		"name" : "/home/lint/vpn/site b.ovpn",
		"use_count" : 0,
		"valid" : false
	}
}
OUT
      exit 0
    fi
    if [[ ${2:-} == "-v" || ${2:-} == "--verbose" ]]; then
      cat <<OUT
Configuration path
Imported                        Last used                 Used
Configuration Name                                        Owner
Tags
$sep
/net/openvpn/v3/configuration/aa11
2026-08-20 09:10:00             2026-08-20 09:14:02          3
work.ovpn                                                 lint
Tags: (none)
$sep
/net/openvpn/v3/configuration/bb22
2026-08-21 10:00:00                                          0
!! /home/lint/vpn/site b.ovpn                             lint
Invalid: Configuration profile is missing required options: --ca
Tags: (none)
$sep
OUT
      exit 0
    fi
    # The plain table carries no D-Bus path, which is exactly why neither the
    # widget nor its tests read it.
    cat <<OUT
Configuration Name                                        Last used
$sep
work.ovpn                                                 2026-08-20 09:14:02
!! /home/lint/vpn/site b.ovpn                             -
$sep
OUT
    ;;
  config-import)
    if [[ ${TUNNELSNAKE_FAKE_IMPORT:-ok} == fail ]]; then
      echo "openvpn3: could not parse configuration file" >&2
      exit 1
    fi
    echo "Configuration imported.  Configuration path: /net/openvpn/v3/configuration/cc33"
    if [[ ${TUNNELSNAKE_FAKE_IMPORT:-ok} == warn ]]; then
      echo "WARNING:   Configuration profile is missing required options: --ca"
    fi
    ;;
  session-start)
    # --background says nothing about web authentication; the URL is only ever
    # available through session-auth. This mirrors that exactly.
    echo "Using configuration profile from file: ${3:-profile}"
    echo "Session path: /net/openvpn/v3/sessions/1f75b30bsb651s42c0"
    echo "Session is running in the background"
    ;;
  session-manage) echo "Session disconnected" ;;
  *) echo "unknown: $*" >&2; exit 1 ;;
esac
